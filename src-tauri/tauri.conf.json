{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DriveTooth",
  "mainBinaryName": "drivetooth",
  "version": "0.1.0",
  "identifier": "com.verunum.drivetooth",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DriveTooth",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Password-gated in-place encryption for removable drives",
    "longDescription": "DriveTooth encrypts every file inside a chosen scope on a drive and hides the directory tree behind an encrypted manifest, so the contents stay private even when the drive is plugged into a machine you do not control.",
    "copyright": "Verunum",
    "category": "Security",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
